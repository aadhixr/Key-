<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5F5"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Admin Control Panel"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Remotely toggle monitoring on any target device."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target Device Model (e.g. moto_g85_5G)"
        android:padding="14dp"
        android:background="#FFFFFF"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnConnectDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect to Device"
        android:backgroundTint="#0277BD"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/btnToggleKeyLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remote Key Logger: LOADING..."
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnToggleNotifLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remote Notification Logger: LOADING..."
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
