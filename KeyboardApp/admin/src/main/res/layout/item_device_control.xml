<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Device Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💻"
            android:textSize="18sp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/txtDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NODE_ID"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#C9D1D9"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#3FB950"
            android:background="#1B4721"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />
    </LinearLayout>

    <!-- Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnToggleKeyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KEY_LOG: ON"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnToggleNotifLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NOTIF_LOG: ON"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Log Console Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INDIVIDUAL TELEMETRY FEED:"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="#8B949E"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <!-- Scrollable Terminal Log Console (ScrollView handles scroll natively) -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="#0D1117"
        android:padding="10dp"
        android:fillViewport="false">

        <TextView
            android:id="@+id/txtDeviceLogConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for telemetry..."
            android:textSize="11sp"
            android:textColor="#3FB950"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
