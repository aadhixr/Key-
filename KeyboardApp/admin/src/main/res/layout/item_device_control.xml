<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="14dp">

    <!-- Device Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txtDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NODE_ID"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:background="#E8F5E9"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <!-- Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnToggleKeyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KEY_LOG: ON"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btnToggleNotifLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NOTIF_LOG: ON"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_button"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <!-- Individual Device Log Console Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INDIVIDUAL TELEMETRY FEED:"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="#555555"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <!-- Scrollable Individual Log Console -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:fillViewport="true"
        android:background="#161B22"
        android:padding="8dp">

        <TextView
            android:id="@+id/txtDeviceLogConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for telemetry..."
            android:textSize="11sp"
            android:textColor="#58A6FF"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
